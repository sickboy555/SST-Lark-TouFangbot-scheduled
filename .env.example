LARK_APP_ID=填入你的AppID
LARK_APP_SECRET=填入你的AppSecret
LARK_CHAT_ID=填入目标群chat_id
LARK_SHEET_URL=填入表格URL

# app：用 Lark 自建应用机器人发群；webhook：用外部群自定义机器人 Webhook 发群
SEND_MODE=app
LARK_WEBHOOK_URL=填入外部群自定义机器人的Webhook地址
# Webhook 开启签名校验时再填写
LARK_WEBHOOK_SECRET=

# 国际版 Lark 用 open.larksuite.com；飞书国内版用 open.feishu.cn
LARK_OPEN_BASE_URL=https://open.larksuite.com

# 表格扫描范围
SHEET_RANGE=A1:AZ1000

# 每天自动发送时间（北京时间）
SCHEDULE_TIME=17:00
TIMEZONE=Asia/Shanghai

# 生成图片输出目录
OUTPUT_DIR=output

# 读取公式单元格时的稳定性保护：连续两次结果一致才继续发送
LARK_STABILITY_RETRIES=4
LARK_STABILITY_DELAY_SECONDS=2

# 是否删除今天和昨天都为 0 的包/国家；默认 false，与 Lark 原表保持一致
FILTER_ZERO_ROWS=true
