LARK_APP_ID=填入你的AppID
LARK_APP_SECRET=填入你的AppSecret
LARK_CHAT_ID=填入目标群chat_id
LARK_SHEET_URL=填入表格URL

# 国际版 Lark 用 open.larksuite.com；飞书国内版用 open.feishu.cn
LARK_OPEN_BASE_URL=https://open.larksuite.com

# 表格扫描范围
SHEET_RANGE=A1:AZ1000

# 每天自动发送时间（北京时间）
SCHEDULE_TIME=17:00
TIMEZONE=Asia/Shanghai

# 生成图片输出目录
OUTPUT_DIR=output
